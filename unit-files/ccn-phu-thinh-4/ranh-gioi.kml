<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Cụm công nghiệp Phú Thịnh 4</name>
    <description><![CDATA[
      <b>Tên:</b> Cụm công nghiệp Phú Thịnh 4<br/>
      <b>Vị trí:</b> Phường Văn Phú (Tổ dân phố Đăng Thọ, Vạn Xuân) và xã Yên Bình<br/>
      <b>Diện tích quy hoạch:</b> 75 ha (trong đó thuộc phường Văn Phú khoảng 28 ha)<br/>
      <b>Ngành nghề dự kiến:</b> Chế biến nông, lâm, thủy sản; may mặc và công nghiệp phụ trợ; vật liệu xây dựng; cơ khí chế tạo, công nghiệp hỗ trợ, điện tử.<br/>
      <b>Nguồn:</b> Báo cáo số 181/BC-UBND ngày 28/4/2026 của UBND phường Văn Phú<br/>
      <b>Căn cứ quy hoạch tỉnh:</b> QĐ số 525/QĐ-UBND ngày 25/02/2026
    ]]></description>

    <Style id="vungStyle">
      <LineStyle>
        <color>ff0000ff</color>
        <width>3</width>
      </LineStyle>
      <PolyStyle>
        <color>7f0000ff</color>
        <fill>1</fill>
        <outline>1</outline>
      </PolyStyle>
    </Style>

    <Style id="diemStyle">
