<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Cụm công nghiệp Phú Thịnh 6</name>
    <description><![CDATA[
      <b>Tên:</b> Cụm công nghiệp Phú Thịnh 6<br/>
      <b>Vị trí:</b> Phường Văn Phú (Tổ dân phố Cầu Yên, Đồng Tiến, Trung Nghiêm)<br/>
      <b>Diện tích quy hoạch:</b> 75 ha<br/>
      <b>Ngành nghề dự kiến:</b> Vật liệu xây dựng; cơ khí chế tạo, công nghiệp hỗ trợ, điện tử; hàng tiêu dùng; công nghiệp kỹ thuật số và năng lượng thông minh; dịch vụ kho bãi, đóng gói, sửa chữa thiết bị.<br/>
      <b>Nguồn:</b> Báo cáo số 181/BC-UBND ngày 28/4/2026 của UBND phường Văn Phú<br/>
      <b>Căn cứ quy hoạch tỉnh:</b> QĐ số 525/QĐ-UBND ngày 25/02/2026
    ]]></description>

    <Style id="vungStyle">
      <LineStyle>
        <color>ff00ff00</color>
        <width>3</width>
      </LineStyle>
      <PolyStyle>
        <color>7f00ff00</color>
        <fill>1</fill>
        <outline>1</outline>
